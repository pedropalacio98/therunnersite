---
const { title, description = '' } = Astro.props;
import '../styles/global.css';
import RunningNavbar from '../components/RunningNavbar.jsx';
import RunningFooter from '../components/RunningFooter.jsx';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="font-sans text-gray-900 flex flex-col min-h-screen">
    <RunningNavbar client:load />
    <main class="flex-1">
      <div class="container mx-auto mt-20 px-6">
        <slot />
      </div>
    </main>

    <RunningFooter client:visible />
  </body>
</html>