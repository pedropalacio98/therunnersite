---
const { title } = Astro.props;
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="font-sans bg-white text-gray-900">
    <nav class="bg-white shadow-md">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-heading text-blue-600">Mi Running</a>
        <ul class="flex space-x-6">
          <li><a href="/" class="hover:text-primary">Inicio</a></li>
          <li><a href="/reviews" class="hover:text-primary">Reviews</a></li>
          <li><a href="/about" class="hover:text-primary">Sobre mí</a></li>
        </ul>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-gray-100 text-center py-6 mt-12">
      <p class="text-sm text-gray-600">© 2025 Mi Sitio de Running. Afiliado Amazon.</p>
    </footer>
  </body>
</html>