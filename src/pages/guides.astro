---
import Layout from '../layouts/BaseLayout.astro';

const guides = [
    {
        title: "Training for Beginners",
        description: "A beginner's guide to running training with tips, plans, and advice.",
        slug: "/guides/training-for-beginners",
    },
    {
        title: "Advanced Running Techniques",
        description: "Discover advanced techniques to enhance your performance and endurance.",
        slug: "/guides/advanced-running-techniques",
    },
    {
        title: "Nutrition for Runners",
        description: "Fuel your running with these nutritional tips and meal plans.",
        slug: "/guides/nutrition-for-runners",
    },
    {
        title: "Injury Prevention",
        description: "Learn how to avoid common running injuries and keep training safely.",
        slug: "/guides/injury-prevention",
    },
];
---

<Layout title="Running Guides" description="Explore our collection of guides for running training, advanced techniques, nutrition tips, and injury prevention to enhance your performance and endurance.">
    <section class="container mx-auto px-4 py-10">
        <header class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">Running Guides and Training Help</h1>
            <p class="text-lg text-gray-700">
                Discover detailed guides to improve your running techniques, training routines, and overall performance.
            </p>
        </header>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {guides.map(guide => (
                <li class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow duration-200">
                    <a href={guide.slug} class="block p-6">
                        <article>
                            <h2 class="text-2xl font-semibold text-blue-600 mb-2">{guide.title}</h2>
                            <p class="text-gray-600">{guide.description}</p>
                            {guide.topics && guide.topics.length > 0 && (
                                <div class="mt-4">
                                    <h3 class="text-lg font-medium text-gray-800">Topics:</h3>
                                    <ul class="list-disc list-inside text-gray-600">
                                        {guide.topics.map(topic => (
                                            <li>{topic}</li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </article>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</Layout>