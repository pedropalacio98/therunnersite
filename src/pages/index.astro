---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import marathonIcon     from '../images/icons/marathon.png';
import halfMarathonIcon from '../images/icons/halfMarathon.png';
import tenKIcon         from '../images/icons/10k.png';
import trailIcon        from '../images/icons/trail.png';
import categories from '../data/categories.js'

---

<BaseLayout title="Inicio - Mi Running">
  <section class="relative bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-20 rounded-b-3xl overflow-hidden">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-extrabold mb-4 drop-shadow-lg">Encuentra tus Zapatillas Ideales</h1>
      <p class="text-xl mb-8 drop-shadow-sm">Guías, comparativas y enlaces directos para cada distancia y terreno.</p>
      <a href="#categories" class="inline-block bg-white text-blue-600 font-semibold py-3 px-6 rounded-full hover:bg-gray-100 transition">
        Explorar Categorías
      </a>
    </div>

  </section>

  <!-- Categories Grid -->
  <section id="categories" class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-heading text-center mb-12">Categorías de Zapatillas</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {categories.map((cat) => (
          <a
            key={cat.slug}
            href={`/${cat.slug}`}
            class="group block bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition transform hover:-translate-y-1"
          >
            <div class="relative h-48">
              <Picture
              src={cat.image}
              alt={cat.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
              />
            </div>
            <div class="p-6 text-center">
              <h3 class="text-2xl font-semibold mb-2 group-hover:text-blue-600 transition-colors">
                {cat.name}
              </h3>
              <span class="inline-block mt-2 text-sm text-gray-500">Ver reviews y guías</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
